@model BayData
@using OmpRfidDashboard.Models

@* Equipment image container. Same structure as before so the asset can later be swapped for a GIF/stream. *@
<div class="relative w-full h-full min-h-[70px] overflow-hidden flex items-center justify-center">
    <img src="@(string.IsNullOrEmpty(Model.EquipmentVisualUrl) ? "/images/hd875.jpg" : Model.EquipmentVisualUrl)"
         alt="Equipment @Model.EquipmentId"
         class="absolute inset-0 h-full w-full object-contain object-center" />
</div>
