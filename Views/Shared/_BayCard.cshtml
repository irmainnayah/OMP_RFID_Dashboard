@using OmpRfidDashboard.Models
@model BayData
@{
    var isEmpty = Model.Status is null;
    var isOverdue = Model.Status == ServiceStatus.Overdue;

    // Same source as the countdown: full ISO date when present, otherwise HH:mm.
    var countdownTarget = !string.IsNullOrEmpty(Model.TargetFinishDate) ? Model.TargetFinishDate : Model.TargetFinish;

    var statusAttr = Model.Status switch
    {
        ServiceStatus.Overdue => "OVERDUE",
        ServiceStatus.InService => "IN_SERVICE",
        _ => "EMPTY",
    };

    // Overdue state is also switched on the client (dashboard.js) once the countdown goes negative.
    var cardBorder = isOverdue
        ? "border-[3px] border-[#FF334F] shadow-[0_0_0_2px_rgba(255,51,79,0.35),0_0_12px_rgba(255,51,79,0.45),0_0_28px_rgba(255,51,79,0.35)] animate-overdue-glow"
        : "border border-[#D3E0EC]";
}

@* Individual workshop bay monitoring card.
   Layout: HEADER (bay number + status) / EQUIPMENT / SERVICE (mechanic, times) / COUNTDOWN *@
<article data-bay-card
         data-status="@statusAttr"
         data-finish="@Model.TargetFinish"
         data-finish-date="@Model.TargetFinishDate"
         data-target="@countdownTarget"
         class="relative flex h-auto w-full flex-col overflow-hidden rounded-[12px] @cardBorder bg-[#F2F6FB] shadow-[0_2px_10px_rgba(10,27,46,0.06)] lg:h-full"
         aria-label="Bay @Model.BayNumber">

    @* Organic blue wave background (decorative) *@
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <svg class="absolute -left-[8%] -top-[5%] h-[30%] w-[116%]" viewBox="0 0 1200 300" preserveAspectRatio="none">
            <path d="M0,82 C120,42 210,42 320,82 C430,122 500,158 620,132 C760,102 820,48 955,62 C1065,74 1120,112 1200,96 L1200,0 L0,0 Z"
                  fill="#DDECF8" fill-opacity="0.92" />
            <path d="M0,112 C125,72 215,72 330,112 C450,154 520,184 635,158 C770,128 835,82 960,94 C1070,104 1130,140 1200,122 L1200,0 L0,0 Z"
                  fill="#EAF4FB" fill-opacity="0.94" />
        </svg>

        <svg class="absolute -left-[6%] top-[0%] h-[25%] w-[112%]" viewBox="0 0 1200 250" preserveAspectRatio="none">
            <path d="M0,92 C135,130 235,132 350,92 C470,50 560,48 680,86 C805,126 900,142 1010,108 C1100,80 1150,78 1200,92 L1200,250 L0,250 Z"
                  fill="#D2E6F5" fill-opacity="0.24" />
        </svg>
    </div>

    @* HEADER: bay number + status badge *@
    <div class="relative z-10 shrink-0 border-b border-[#D3E0EC] px-3 py-1.5 xl:px-3.5 xl:py-2">
        <div class="flex items-center justify-between gap-2">
            <h2 class="text-sm font-bold leading-tight tracking-[-0.01em] text-[#0A1B2E] sm:text-base xl:text-lg">@Model.BayNumber</h2>

            <div class="shrink-0">
                @if (!isEmpty)
                {
                    @* Both badges are rendered; dashboard.js shows the one that matches the live state. *@
                    <div data-badge="IN_SERVICE" class="@(isOverdue ? "hidden" : "")">
                        <partial name="_StatusBadge" model="ServiceStatus.InService" />
                    </div>
                    <div data-badge="OVERDUE" class="@(isOverdue ? "" : "hidden")">
                        <partial name="_StatusBadge" model="ServiceStatus.Overdue" />
                    </div>
                }
            </div>
        </div>
    </div>

    @if (isEmpty)
    {
        <div class="relative z-10 flex min-h-0 flex-1 items-center justify-center p-3">
            <div class="text-center">
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#6F88A3] sm:text-sm">EMPTY</p>
                <p class="mt-0.5 text-[9px] font-medium uppercase tracking-[0.12em] text-[#9AAEC1] sm:text-[10px]">No Active Service</p>
            </div>
        </div>
    }
    else
    {
        <div class="relative z-10 flex min-h-0 flex-1 gap-2 p-2.5 xl:gap-3 xl:p-3">

            @* LEFT: information panel *@
            <div class="flex min-w-0 flex-1 flex-col justify-between">

                @* 1. Equipment ID *@
                <div class="shrink-0">
                    <p class="text-[7.5px] font-medium uppercase tracking-[0.12em] text-[#6F88A3] sm:text-[8px]">Equipment ID</p>
                    <p class="truncate text-sm font-bold leading-tight tracking-tight text-[#0A1B2E] sm:text-base xl:text-lg">@Model.EquipmentId</p>
                </div>

                @* 2. Start time and estimated finish *@
                <div class="my-1 grid grid-cols-2 gap-2 shrink-0">
                    @if (!string.IsNullOrEmpty(Model.StartService))
                    {
                        <div>
                            <p class="text-[7.5px] font-medium uppercase tracking-[0.1em] text-[#6F88A3] sm:text-[8px]">Start Time</p>
                            <p style="font-family: var(--font-plex-sans-condensed), var(--font-plex-sans), sans-serif; transform: scaleY(1.18); transform-origin: bottom left;"
                               class="inline-block text-xl font-bold tabular-nums tracking-normal text-[#0A1B2E] leading-tight sm:text-2xl xl:text-3xl">@Model.StartService</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.TargetFinish))
                    {
                        <div>
                            <p class="text-[7.5px] font-medium uppercase tracking-[0.1em] text-[#6F88A3] sm:text-[8px]">Estimate</p>
                            <p style="font-family: var(--font-plex-sans-condensed), var(--font-plex-sans), sans-serif; transform: scaleY(1.18); transform-origin: bottom left;"
                               class="inline-block text-xl font-bold tabular-nums tracking-normal text-[#0A1B2E] leading-tight sm:text-2xl xl:text-3xl">@Model.TargetFinish</p>
                        </div>
                    }
                </div>

                @* 3. Mechanic *@
                @if (!string.IsNullOrEmpty(Model.Mechanic))
                {
                    <div class="shrink-0">
                        <p class="text-[7px] font-medium uppercase tracking-[0.1em] text-[#6F88A3] sm:text-[7.5px]">Mechanic</p>
                        <p class="truncate text-[10px] font-semibold text-[#294663] sm:text-xs">@Model.Mechanic</p>
                    </div>
                }

                @* 4. Countdown (HH:MM:SS, "-" prefix after the target time) *@
                <div class="mt-0.5 shrink-0 border-t border-[#D3E0EC]/80 pt-0.5">
                    <span class="text-[7px] font-medium uppercase tracking-[0.12em] text-[#6F88A3] sm:text-[7.5px]">Countdown</span>
                    <p data-countdown
                       class="text-sm font-bold leading-none tracking-[-0.02em] tabular-nums sm:text-base xl:text-lg @(isOverdue ? "text-[#1B6FB8]" : "text-[#0A1B2E]")">--:--:--</p>
                </div>
            </div>

            @* RIGHT: equipment image *@
            <div class="flex w-[38%] xl:w-[40%] shrink-0 flex-col justify-center overflow-hidden">
                <div class="h-full w-full [&>*]:h-full [&>*]:w-full">
                    <partial name="_EquipmentVisual" model="Model" />
                </div>
            </div>
        </div>
    }
</article>
