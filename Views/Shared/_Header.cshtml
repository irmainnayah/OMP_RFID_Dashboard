<header class="w-full shrink-0 border-b border-slate-700/60 bg-[#0a1b2e] px-6 py-2 sm:px-7 sm:py-2.5">
    <div class="flex w-full items-center justify-between gap-6">

        @* LEFT: PAMA logo + dashboard title *@
        <div class="flex min-w-0 items-center gap-3">

            <div class="relative h-12 w-14 shrink-0 rounded-[9px] bg-slate-50 sm:h-13 sm:w-16">
                <img src="~/images/pama-logo.png" alt="PAMA Logo"
                     class="absolute inset-0 h-full w-full object-contain p-1" />
            </div>

            <div class="h-8 w-px shrink-0 bg-slate-400/30" aria-hidden="true"></div>

            <div class="min-w-0">
                <p class="mb-0.5 text-[10px] font-medium uppercase tracking-[0.18em] leading-none text-slate-300 sm:text-[11px]">
                    SMMS WORKSHOP
                </p>

                <h1 class="truncate text-base font-semibold leading-tight tracking-tight text-white sm:text-lg lg:text-xl">
                    SERVICE MONITORING DASHBOARD
                </h1>
            </div>
        </div>

        @* RIGHT: date + clock (updated every second by dashboard.js) *@
        <div class="shrink-0 text-right">
            <div id="header-date" class="text-[10px] font-medium uppercase tracking-[0.12em] text-slate-300 sm:text-[11px]">
                Loading...
            </div>

            <div id="header-time" class="font-mono text-base font-semibold leading-tight tracking-wider tabular-nums text-white sm:text-lg">
                --:--:--
            </div>
        </div>
    </div>
</header>
