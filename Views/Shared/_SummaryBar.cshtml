@model OmpRfidDashboard.Models.BaySummary

@* Workshop status summary. Counts are recomputed every second by dashboard.js. *@
<section aria-label="Workshop Status Summary" class="w-full max-w-[1720px] mx-auto px-5 sm:px-6 lg:px-7 pb-1 shrink-0">
    <div class="relative overflow-hidden rounded-[12px] border border-[#C9D9E7] bg-[#F2F6FB] shadow-[0_2px_10px_rgba(10,27,46,0.05)]">

        @* Subtle animated wave (decorative only) *@
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[42%] overflow-hidden" aria-hidden="true">
            <svg class="absolute -bottom-1 -left-[4%] h-full w-[108%] animate-summary-wave-slow" viewBox="0 0 1200 180" preserveAspectRatio="none">
                <path d="M0,100 C120,72 220,72 340,102 C470,134 555,136 675,104 C800,70 900,62 1020,94 C1100,116 1150,116 1200,100 L1200,180 L0,180 Z"
                      fill="#C7E2F4" fill-opacity="0.9" />
            </svg>

            <svg class="absolute -bottom-1 -left-[2%] h-[82%] w-[104%] animate-summary-wave" viewBox="0 0 1200 150" preserveAspectRatio="none">
                <path d="M0,88 C130,60 230,62 350,88 C470,114 560,116 680,88 C810,58 900,52 1025,78 C1110,96 1155,96 1200,84 L1200,150 L0,150 Z"
                      fill="#EAF4FB" fill-opacity="0.78" />
            </svg>
        </div>

        <div class="relative z-10 grid grid-cols-2 lg:grid-cols-4">

            @* Total Bays *@
            <div class="flex items-center px-4 py-1.5 lg:border-r lg:border-[#D3E0EC] lg:px-5 lg:py-2">
                <div>
                    <p class="text-[8px] font-medium uppercase tracking-[0.14em] text-[#6F88A3] sm:text-[9px]">Total Bays</p>
                    <p class="text-lg font-semibold leading-tight tracking-[-0.02em] tabular-nums text-[#0A1B2E] sm:text-xl lg:text-2xl">@Model.TotalBays.ToString("00")</p>
                </div>
            </div>

            @* In Service *@
            <div class="flex items-center border-l border-b border-[#D3E0EC] px-4 py-1.5 lg:border-l-0 lg:border-b-0 lg:border-r lg:px-5 lg:py-2">
                <div>
                    <p class="text-[8px] font-medium uppercase tracking-[0.14em] text-[#6F88A3] sm:text-[9px]">In Service</p>
                    <p data-summary="in-service" class="text-lg font-semibold leading-tight tracking-[-0.02em] tabular-nums text-[#167A70] sm:text-xl lg:text-2xl">@Model.InServiceCount.ToString("00")</p>
                </div>
            </div>

            @* Overdue *@
            <div class="flex items-center border-t border-[#D3E0EC] px-4 py-1.5 lg:border-t-0 lg:border-r lg:px-5 lg:py-2">
                <div>
                    <p class="text-[8px] font-medium uppercase tracking-[0.14em] text-[#6F88A3] sm:text-[9px]">Overdue</p>
                    <p data-summary="overdue" class="text-lg font-semibold leading-tight tracking-[-0.02em] tabular-nums text-[#C83D4A] sm:text-xl lg:text-2xl">@Model.OverdueCount.ToString("00")</p>
                </div>
            </div>

            @* Empty *@
            <div class="flex items-center border-l border-t border-[#D3E0EC] px-4 py-1.5 lg:border-l-0 lg:border-t-0 lg:px-5 lg:py-2">
                <div>
                    <p class="text-[8px] font-medium uppercase tracking-[0.14em] text-[#6F88A3] sm:text-[9px]">Empty</p>
                    <p data-summary="empty" class="text-lg font-semibold leading-tight tracking-[-0.02em] tabular-nums text-[#5D7893] sm:text-xl lg:text-2xl">@Model.EmptyCount.ToString("00")</p>
                </div>
            </div>
        </div>
    </div>
</section>
