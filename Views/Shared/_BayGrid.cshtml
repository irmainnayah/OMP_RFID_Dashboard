@model OmpRfidDashboard.Models.DashboardViewModel

@* Single-screen 8-card layout: 4 columns x 2 rows, no scrolling on 16:9 displays.
   Row 1: PARKIRAN DALAM (BAY 01, 02, 07, 08). Row 2: PARKIRAN LUAR (BAY 01, 02, 07, 08). *@
<main aria-label="Workshop Bay Monitoring Grid"
      class="w-full max-w-[1720px] mx-auto px-4 sm:px-6 lg:px-7 py-1.5 lg:py-2 flex-1 min-h-0 flex flex-col justify-between gap-1.5 lg:gap-2">

    <section aria-label="Section Indoor Bays" class="flex min-h-0 flex-1 flex-col">
        <div class="mb-1 flex shrink-0 items-center gap-2">
            <span class="h-4 w-1.5 rounded-full bg-gradient-to-b from-[#1B6FB8] to-[#19C5D8]" aria-hidden="true"></span>
            <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-cyan-300 sm:text-base">INDOOR BAYS</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-2.5 xl:gap-3 flex-1 min-h-0 items-stretch">
            @foreach (var bay in Model.IndoorBays)
            {
                <partial name="_BayCard" model="bay" />
            }
        </div>
    </section>

    <section aria-label="Section Outdoor Bays" class="flex min-h-0 flex-1 flex-col">
        <div class="mb-1 flex shrink-0 items-center gap-2">
            <span class="h-4 w-1.5 rounded-full bg-gradient-to-b from-[#F59E0B] to-[#FBBF24]" aria-hidden="true"></span>
            <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-amber-400 sm:text-base">OUTDOOR BAYS</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-2.5 xl:gap-3 flex-1 min-h-0 items-stretch">
            @foreach (var bay in Model.OutdoorBays)
            {
                <partial name="_BayCard" model="bay" />
            }
        </div>
    </section>
</main>
